{
  "name": "stavan-font",
  "version": "1.2.0",
  "description": "A handwriting font made from 675 pages of real Apple Pencil notes, plus a tiny library that replays the pen strokes as animated SVG.",
  "type": "module",
  "license": "OFL-1.1 AND MIT",
  "author": "Stavan",
  "homepage": "https://font.stavan.ai",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Whiteknight07/stavan-font.git"
  },
  "bugs": "https://github.com/Whiteknight07/stavan-font/issues",
  "keywords": [
    "font",
    "handwriting",
    "handwriting-font",
    "webfont",
    "woff2",
    "svg",
    "animation",
    "goodnotes",
    "apple-pencil"
  ],
  "main": "site/stavan.js",
  "exports": {
    ".": "./site/stavan.js",
    "./css": "./dist/stavan.css",
    "./dist/*": "./dist/*",
    "./data/*": "./site/data/*"
  },
  "bin": {
    "stavan-write": "site/write.mjs"
  },
  "files": [
    "dist/*.ttf",
    "dist/*.woff",
    "dist/*.woff2",
    "dist/*.svg",
    "dist/stavan.css",
    "site/stavan.js",
    "site/write.mjs",
    "site/data/stavan-*.json",
    "site/data/strokes.json",
    "OFL.txt",
    "LICENSE",
    "site/notebook.js",
    "site/print3d.js",
    "site/make/fontmaker.js"
  ],
  "scripts": {
    "test": "node test/layout.test.mjs && node test/exports.test.mjs",
    "build:site": "sh scripts/build-site.sh",
    "dev": "sh scripts/build-site.sh && npx wrangler dev",
    "deploy": "sh scripts/build-site.sh && npx wrangler deploy"
  },
  "devDependencies": {
    "opentype.js": "1.3.4",
    "polygon-clipping": "0.15.7"
  }
}
